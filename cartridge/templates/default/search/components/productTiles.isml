<isloop items="${pdict.productSearch.productIds}" status="tilesLoop" var="product">
    <div id="tile-${product.productID}" class="col-6 ${grid4 ? "col-lg-3" : "col-lg-4"} px-0" data-product-position="${tilesLoop.index}" data-product-type="${!product.isSponsored ? product.productSearchHit.hitType : ""}">
            <isif condition="${product.isSponsored === true}">
            <div class="featured-item-label">
                <isscript>
                    // Localization can optionally be used here
                    // var featuredText = Resource.msg('label.product.featured', 'product', null);
                </isscript>
                Featured
            </div>
            <script>
                if (window.ProductEngagement) {
                    var querystring = '${pdict.queryString}';
                    var regex = /cgid=([^&]*)/;
                    var match = querystring.match(regex);
                    var categoryId = match && match.length > 1 ? match[1] : '';

                    ProductEngagement.setupItemTracking({
                        productId: '${product.productID}',
                        userId: '${pdict.tsuid || ""}',
                        position: ${tilesLoop.index + 1},
                        page: ${pdict.productSearch.page || 1},
                        pageSize: ${pdict.productSearch.hitsPerPage || 12},
                        categoryId: categoryId,
                        resolvedBidId: '${product.resolvedBidId || ""}'
                    });
                }
            </script>
        </isif>
        <isobject object="${product.productSearchHit}" view="searchhit">
            <isif condition="${pdict.productSearch.category}">
                <isinclude url="${URLUtils.url('Tile-Show', 'pid', product.productID, 'swatches', true, 'ratings', true, 'cgid', pdict.productSearch.category.id, 'compare', pdict.compareEnabled, 'addToCartButton', true, 'attributeMain', true, 'isSponsored', product.isSponsored)}" />
            <iselse/>
                <isinclude url="${URLUtils.url('Tile-Show', 'pid', product.productID, 'swatches', true, 'ratings', true, 'compare', false, 'addToCartButton', true, 'attributeMain', true, 'isSponsored', product.isSponsored)}" />
            </isif>
        </isobject>
    </div>
</isloop>
