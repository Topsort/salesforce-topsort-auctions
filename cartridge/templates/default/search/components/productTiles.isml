<isinclude template="topsort/trackingInit" />
<isloop items="${pdict.productSearch.productIds}" status="tilesLoop" var="product">
    <div id="tile-${product.productID}" class="col-6 ${(typeof grid4 != 'undefined' && grid4) ? "col-lg-3" : "col-lg-4"} px-0" data-product-position="${tilesLoop.index}" data-product-type="${!product.isSponsored ? product.productSearchHit.hitType : ""}">
        <isif condition="${product.isSponsored === true}">
            <iscomment>
                categoryId and searchQuery come straight from the shopper's query string, so
                the payload is serialised through toScriptJson: JSON.stringify on its own
                leaves a closing script tag intact, and this is printed with encoding="off".
            </iscomment>
            <isscript>
                var topsortTileParams = require('*/cartridge/scripts/helpers/topsortHelpers').toScriptJson({
                    productId: product.productID,
                    position: tilesLoop.index + 1,
                    page: pdict.productSearch.pageNumber || 1,
                    pageSize: pdict.productSearch.pageSize || 12,
                    categoryId: pdict.topsortCategoryId || '',
                    searchQuery: pdict.topsortSearchQuery || '',
                    resolvedBidId: product.resolvedBidId || '',
                    eventToken: product.eventToken || ''
                });
            </isscript>
            <script>
                if (window.ProductEngagement) {
                    ProductEngagement.setupItemTracking(<isprint value="${topsortTileParams}" encoding="off"/>);
                } else {
                    window.topsortTrackingQueue = window.topsortTrackingQueue || [];
                    window.topsortTrackingQueue.push({
                        method: 'setupItemTracking',
                        params: <isprint value="${topsortTileParams}" encoding="off"/>
                    });
                }
            </script>
        </isif>
        <isset name="topsortTileUrl" value="${URLUtils.url('Tile-Show', 'pid', product.productID, 'swatches', true, 'ratings', true, 'attributeMain', true, 'isSponsored', product.isSponsored, 'loading', tilesLoop.count > 4 ? 'lazy' : 'eager', 'fetchpriority', tilesLoop.first ? 'high' : null)}" scope="page" />
        <iscomment>
            A sponsored winner can come from a keyword or category bid rather than from this
            page of results, in which case there is no search hit to report to the analytics
            view. Render the tile without the isobject wrapper instead of handing it null.
        </iscomment>
        <isif condition="${product.productSearchHit}">
            <isobject object="${product.productSearchHit}" view="searchhit">
                <isinclude url="${topsortTileUrl}" />
            </isobject>
        <iselse/>
            <isinclude url="${topsortTileUrl}" />
        </isif>
    </div>
</isloop>
