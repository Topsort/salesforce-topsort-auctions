<iscomment> Category PLPs do not use searchResultsNoDecorator; init tracking here so it runs on search and category grids. </iscomment>
<script src="${URLUtils.staticURL('/js/product-engagement.js')}"></script>
<script>
    if (window.ProductEngagement) {
        ProductEngagement.init({
            apiURL: '${pdict.topsortApiURL}',
            apiKey: '${pdict.topsortApiKey}',
            trackingEnabled: ${pdict.topsortTrackingEnabled ? true : false}
        });
    }
</script>

<isloop items="${pdict.productSearch.productIds}" status="tilesLoop" var="product">
    <div id="tile-${product.productID}" class="col-6 col-sm-4" data-product-position="${tilesLoop.index}" data-product-type="${!product.isSponsored ? product.productSearchHit.hitType : ""}">
            <isif condition="${product.isSponsored === true}">
            <div class="featured-item-label">
                <isscript>
                    // Localization can optionally be used here
                    // var featuredText = Resource.msg('label.product.featured', 'product', null);
                </isscript>
                Featured
            </div>
            <script>
                if (window.ProductEngagement) {
                    var querystring = '${pdict.queryString}';
                    var regex = /cgid=([^&]*)/;
                    var match = querystring.match(regex);
                    var categoryId = match && match.length > 1 ? match[1] : '';

                    ProductEngagement.setupItemTracking({
                        productId: '${product.productID}',
                        userId: '${pdict.tsuid || ""}',
                        position: ${tilesLoop.index + 1},
                        page: ${pdict.productSearch.page || 1},
                        pageSize: ${pdict.productSearch.hitsPerPage || 12},
                        categoryId: categoryId,
                        resolvedBidId: '${product.resolvedBidId || ""}'
                    });
                }
            </script>
        </isif>
        <isobject object="${product.productSearchHit}" view="searchhit">
            <isinclude url="${URLUtils.url('Tile-Show', 'pid', product.productID, 'swatches', true, 'ratings', true, 'isSponsored', product.isSponsored)}" />
        </isobject>
    </div>
</isloop>
