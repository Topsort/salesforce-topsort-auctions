<iscomment> TOPSORT: tracking library, only loaded when the integration is switched on </iscomment>
<isif condition="${pdict.topsortTrackingEnabled}">
    <script src="${URLUtils.staticURL('/js/product-engagement.js')}"></script>
    <script>
        if (window.ProductEngagement) {
            ProductEngagement.init({
                apiURL: '${pdict.topsortApiURL}',
                apiKey: '${pdict.topsortApiKey}',
                trackingEnabled: ${pdict.topsortTrackingEnabled ? true : false}
            });
        }
    </script>
</isif>
<iscomment> END TOPSORT </iscomment>

<section id="main" class="catalog__body">
    <div class="plp-hero-banner-slot">
        <isslot id="searchresults-hero-banner" description="Content slot for full-width banner" context="global" />
    </div>

    <iscomment> TOPSORT SEARCH TOP </iscomment>
    <isset name="searchTopBanner" value="${pdict.bannerWinners ? pdict.bannerWinners['search-top'] : null}" scope="page" />
    <isif condition="${searchTopBanner && searchTopBanner.url}">
        <div id="featured-content-search-top" class="featured-content-container" style="margin-top: 1rem;">
            <a href="${searchTopBanner.redirectionUrl}" target="_blank" rel="noopener">
                <img src="${searchTopBanner.url}" alt="Featured Content" style="width: 100%; border-radius: 12px;" />
            </a>
        </div>
        <isif condition="${searchTopBanner.bidId}">
            <script>
                if (window.ProductEngagement) {
                    ProductEngagement.setupContentTracking({
                        elementId: 'featured-content-search-top',
                        userId: '${pdict.tsuid || ""}',
                        position: 4,
                        page: ${pdict.productSearch.page || 1},
                        pageSize: ${pdict.productSearch.hitsPerPage || 12},
                        categoryId: '${pdict.topsortCategoryId || ""}',
                        resolvedBidId: '${searchTopBanner.bidId || ""}'
                    });
                }
            </script>
        </isif>
    </isif>
    <iscomment> END TOPSORT SEARCH TOP </iscomment>

    <iscomment> TOPSORT CATEGORY TOP </iscomment>
    <isset name="categoryTopBanner" value="${pdict.bannerWinners ? pdict.bannerWinners['category-top'] : null}" scope="page" />
    <isif condition="${categoryTopBanner && categoryTopBanner.url}">
        <div id="featured-content-category-top" class="featured-content-container" style="margin-top: 1rem;">
            <a href="${categoryTopBanner.redirectionUrl}" target="_blank" rel="noopener">
                <img src="${categoryTopBanner.url}" alt="Featured Content" style="width: 100%; border-radius: 12px;" />
            </a>
        </div>
        <isif condition="${categoryTopBanner.bidId}">
            <script>
                if (window.ProductEngagement) {
                    ProductEngagement.setupContentTracking({
                        elementId: 'featured-content-category-top',
                        userId: '${pdict.tsuid || ""}',
                        position: 4,
                        page: ${pdict.productSearch.page || 1},
                        pageSize: ${pdict.productSearch.hitsPerPage || 12},
                        categoryId: '${pdict.topsortCategoryId || ""}',
                        resolvedBidId: '${categoryTopBanner.bidId || ""}'
                    });
                }
            </script>
        </isif>
    </isif>
    <iscomment> END TOPSORT CATEGORY TOP </iscomment>

    <input type="hidden" id="currenturl" class="currenturl" value="${pdict.paging.pageURL}" />
    <input type="hidden" id="isPLP" value="true" />

    <div class="container">
        <isset name="productsNotEmpty" value="${pdict.productSearch.productIds.length > 0}" scope="page" />
        <isset name="contentsNotEmpty" value="${pdict.contentSearch.contents.length > 0}" scope="page" />

        <isif condition="${pdict.reportingURLs && pdict.reportingURLs.length}">
            <isinclude template="reporting/reportingUrls" />
        </isif>

        <div class="search__top">
            <!---Breadcrumbs--->
            <nav aria-label="breadcrumb">
                <isinclude template="components/breadcrumbs/pageBreadcrumbs"/>
            </nav>
        </div>
    </div>

    <div class="container">
        <div class="box box__card ${(contentsNotEmpty && !productsNotEmpty) ? 'hidden' : ''}" id="product-search-results">
            <iscomment> GA4 to be triggered when plp shows </iscomment>
            <isif condition="${!empty(pdict.ga4PLPData)}">
                <input type="hidden" value="${pdict.ga4PLPData}" id="plp-ga4-data">
            </isif>
            <div class="row">
                <isif condition="${productsNotEmpty}">
                    <div class="container">
                        <iscontentasset aid="product-search-results-header"/>
                    </div>
                    <div class="col-12 col-lg-3">
                        <div class="product-filters-wrapper">
                            <div class="products-filters-header">
                                <isif condition="${pdict.productSearch.isCategorySearch}">
                                    <isset name="parentCategory" value="${pdict.isBrandCategoryPage ? dw.web.Resource.msg("suggestions.title.brands", "header", null) : pdict.parentCategoryName}" scope="page" />
                                    <isset name="categoryName" value="${pdict.isBrandCategoryPage && !empty(pdict.brandParam) ? pdict.brandParam : pdict.productSearch.category.name}" scope="page" />

                                    <span class="h4 m-0 text-uppercase">${parentCategory}</span>
                                    <h1 class="h3" role="heading" arial-level="1">${categoryName}</h1>
                                <iselseif condition="${pdict.searchPhrase}" />
                                    <h2 class="h4 m-0">${Resource.msg('label.search.text', 'search', null)}</h2>
                                    <h1 class="h3" role="heading" arial-level="1">${pdict.searchPhrase}</h1>
                                </isif>
                                <span class="product-results-count"><b>${Resource.msgf('label.results.count.total', 'search', null,pdict.paging.totalCount)}</b>${Resource.msg('label.results.count.text', 'search', null)}</span>
                            </div>
                            <!-- Refinement bar -->
                            <div class="d-none d-lg-block">
                                <isinclude url="${pdict.refineurl}"/>

                                <iscomment> TOPSORT CATEGORY SIDE </iscomment>
                                <isset name="categorySideBanner" value="${pdict.bannerWinners ? pdict.bannerWinners['category-side'] : null}" scope="page" />
                                <isif condition="${categorySideBanner && categorySideBanner.url}">
                                    <div id="featured-content-category-side" class="refinement-bar__banner" style="padding: 1rem 0;">
                                        <a href="${categorySideBanner.redirectionUrl}" target="_blank" rel="noopener">
                                            <img src="${categorySideBanner.url}" alt="Category Banner" style="width: 100%; border-radius: 12px;" />
                                        </a>
                                    </div>
                                    <isif condition="${categorySideBanner.bidId}">
                                        <script>
                                            if (window.ProductEngagement) {
                                                ProductEngagement.setupContentTracking({
                                                    elementId: 'featured-content-category-side',
                                                    userId: '${pdict.tsuid || ""}',
                                                    position: 2,
                                                    page: ${pdict.productSearch.page || 1},
                                                    pageSize: ${pdict.productSearch.hitsPerPage || 12},
                                                    categoryId: '${pdict.topsortCategoryId || ""}',
                                                    resolvedBidId: '${categorySideBanner.bidId || ""}'
                                                });
                                            }
                                        </script>
                                    </isif>
                                </isif>
                                <iscomment> END TOPSORT CATEGORY SIDE </iscomment>

                                <iscomment> TOPSORT SEARCH SIDE </iscomment>
                                <isset name="searchSideBanner" value="${pdict.bannerWinners ? pdict.bannerWinners['search-side'] : null}" scope="page" />
                                <isif condition="${searchSideBanner && searchSideBanner.url}">
                                    <div id="featured-content-search-side" class="refinement-bar__banner" style="padding: 1rem 0;">
                                        <a href="${searchSideBanner.redirectionUrl}" target="_blank" rel="noopener">
                                            <img src="${searchSideBanner.url}" alt="Search Side Banner" style="width: 100%; border-radius: 12px;" />
                                        </a>
                                    </div>
                                    <isif condition="${searchSideBanner.bidId}">
                                        <script>
                                            if (window.ProductEngagement) {
                                                ProductEngagement.setupContentTracking({
                                                    elementId: 'featured-content-search-side',
                                                    userId: '${pdict.tsuid || ""}',
                                                    position: 3,
                                                    page: ${pdict.productSearch.page || 1},
                                                    pageSize: ${pdict.productSearch.hitsPerPage || 12},
                                                    categoryId: '${pdict.topsortCategoryId || ""}',
                                                    resolvedBidId: '${searchSideBanner.bidId || ""}'
                                                });
                                            }
                                        </script>
                                    </isif>
                                </isif>
                                <iscomment> END TOPSORT SEARCH SIDE </iscomment>
                            </div>
                            <div class="filter-espot-wrapper"></div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-9 product-grid pt-0" id="product-list">
                        <isslot id="searchresults-secondary-banner" description="Content slot for banner (same width as product results)" context="global" />

                        <div class="grid-filters grid-filters-fixed new-grid-filters new-grid-filters-fixed d-none d-lg-none">
                            <div class="grid-filters-container js-grid-filters-fixed">
                                <div class="filter-col d-flex filter-by filter-modal-container d-lg-none">
                                    <div class="d-flex d-lg-none filter-grid js-filter-btn">
                                        <svg class="icon icon-filter"><use xlink:href="#filter-icon"></use></svg>
                                        <p class="filter-lbl order-lbl text-uppercase no-margins">${Resource.msg('label.control.filter', 'search', null)}</p>
                                    </div>
                                    <isinclude url="${pdict.refineurl}"/>
                                </div>

                                <div class="filter-col d-flex order-by">
                                    <label class="filter-label" for="order-by">${Resource.msg('label.control.sortby', 'search', null)}</label>
                                    <isinclude template="search/sortOrderMenu" />
                                </div>
                            </div>
                        </div>

                        <div class="grid-filters grid-filters-static new-grid-filters">
                            <div class="filter-col d-flex d-lg-none filter-grid js-filter-btn">
                                <svg class="icon icon-filter"><use xlink:href="#filter-icon"></use></svg>
                                <p class="filter-lbl order-lbl text-uppercase no-margins">${Resource.msg('label.control.filter', 'search', null)}</p>
                            </div>

                            <div class="filter-col d-flex order-by">
                                <label class="filter-label d-none d-lg-block" for="order-by">${Resource.msg('label.control.sortby', 'search', null)}</label>
                                <isinclude template="search/sortOrderMenu" />
                            </div>

                            <div class="filter-col d-none d-lg-flex pagination">
                                <isinclude template="search/components/pagination" />
                            </div>
                        </div>

                        <!--- Product Grid --->
                        <div class="row px-3 grid-view product-view loading" id="productRow">
                            <isinclude template="search/productGrid" />
                        </div>

                        <div class="bottom-placeholder">
                            <isinclude template="search/components/pagination" />
                        </div>

                        <iscomment> TOPSORT CATEGORY BOTTOM </iscomment>
                        <isset name="categoryBottomBanner" value="${pdict.bannerWinners ? pdict.bannerWinners['category-bottom'] : null}" scope="page" />
                        <isif condition="${categoryBottomBanner && categoryBottomBanner.url}">
                            <div id="featured-content-category-bottom" class="featured-content-container" style="margin-top: 1rem;">
                                <a href="${categoryBottomBanner.redirectionUrl}" target="_blank" rel="noopener">
                                    <img src="${categoryBottomBanner.url}" alt="Featured Content" style="width: 100%; border-radius: 12px;" />
                                </a>
                            </div>
                            <isif condition="${categoryBottomBanner.bidId}">
                                <script>
                                    if (window.ProductEngagement) {
                                        ProductEngagement.setupContentTracking({
                                            elementId: 'featured-content-category-bottom',
                                            userId: '${pdict.tsuid || ""}',
                                            position: 1,
                                            page: ${pdict.productSearch.page || 1},
                                            pageSize: ${pdict.productSearch.hitsPerPage || 12},
                                            categoryId: '${pdict.topsortCategoryId || ""}',
                                            resolvedBidId: '${categoryBottomBanner.bidId || ""}'
                                        });
                                    }
                                </script>
                            </isif>
                        </isif>
                        <iscomment> END TOPSORT CATEGORY BOTTOM </iscomment>

                        <iscomment> TOPSORT SEARCH BOTTOM </iscomment>
                        <isset name="searchBottomBanner" value="${pdict.bannerWinners ? pdict.bannerWinners['search-bottom'] : null}" scope="page" />
                        <isif condition="${searchBottomBanner && searchBottomBanner.url}">
                            <div id="featured-content-search-bottom" class="featured-content-container" style="margin-top: 1rem; margin-bottom: 3rem;">
                                <a href="${searchBottomBanner.redirectionUrl}" target="_blank" rel="noopener">
                                    <img src="${searchBottomBanner.url}" alt="Featured Content" style="width: 100%; border-radius: 12px;" />
                                </a>
                            </div>
                            <isif condition="${searchBottomBanner.bidId}">
                                <script>
                                    if (window.ProductEngagement) {
                                        ProductEngagement.setupContentTracking({
                                            elementId: 'featured-content-search-bottom',
                                            userId: '${pdict.tsuid || ""}',
                                            position: 4,
                                            page: ${pdict.productSearch.page || 1},
                                            pageSize: ${pdict.productSearch.hitsPerPage || 12},
                                            categoryId: '${pdict.topsortCategoryId || ""}',
                                            resolvedBidId: '${searchBottomBanner.bidId || ""}'
                                        });
                                    }
                                </script>
                            </isif>
                        </isif>
                        <iscomment> END TOPSORT SEARCH BOTTOM </iscomment>

                        <isslot id="searchresults-footer-secondary-banner" description="Content slot for banner to display below pagination" context="global" />
                    </div>
                <iselse/>
                    <isobject object="${pdict.productSearch.productSearch}" view="none"> </isobject>
                    <isinclude template="search/components/emptyResults" />
                </isif>
            </div>
        </div>
    </div>

    <isif condition="${contentsNotEmpty}">
        <div class="box box__card ${productsNotEmpty ? 'hidden' : ''}" id="articles-search-results">
            <iscontentasset aid="articles-search-results-header" />

            <div class="container">
                <isinclude template="search/contentGrid" />
                <div class="recommendation-slider-wrapper">
                    <isslot id="recommended-products" description="Carousel of recommended products driven by Einstein Product Recommendation." context="global" />
                </div>
            </div>

            <iscontentasset aid="articles-search-results-footer" />
        </div>
    </isif>

    <div class="mt-8">
        <isslot id="searchresults-footer-banner" description="Content slot for full-width banner to display below product grid/list" context="global" />
    </div>
</section>
