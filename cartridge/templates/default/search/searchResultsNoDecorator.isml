<iscomment>
    Override of app_storefront_hites/search/searchResultsNoDecorator.isml.

    Identical to the original apart from the two Topsort banner slots marked below. ISML has
    no module.superModule, so the rest of this file is a copy and a later change to the HITES
    original has to be brought across by hand - the README lists this under the overrides that
    need a diff check.
</iscomment>
<iscomment>
    This template serves keyword search, and a search can also be scoped to a category. The
    search term is the stronger statement of intent, so it picks both the slot and the auction
    trigger, exactly as topsortListings does for the products in the grid.
</iscomment>
<isset name="tsSearchQuery" value="${pdict.searchPhrase || ''}" scope="page" />
<isset name="tsCategoryId" value="${(pdict.productSearch && pdict.productSearch.category) ? pdict.productSearch.category.id : ''}" scope="page" />
<isset name="tsSideSlotId" value="${tsSearchQuery ? 'search-side' : 'category-side'}" scope="page" />
<isset name="tsFooterSlotId" value="${tsSearchQuery ? 'search-bottom' : 'category-bottom'}" scope="page" />
<section id="main" class="catalog__body">
    <div class="plp-hero-banner-slot">
        <isslot id="searchresults-hero-banner" description="Content slot for full-width banner" context="global" />
    </div>
    <input type="hidden" id="currenturl" class="currenturl" value="${pdict.paging.pageURL}" />
    <input type="hidden" id="isPLP" value="true" />
    <div class="container">
        <isset name="productsNotEmpty" value="${pdict.productSearch.productIds.length > 0}" scope="page" />
        <isset name="contentsNotEmpty" value="${pdict.contentSearch.contents.length > 0}" scope="page" />

        <isif condition="${pdict.reportingURLs && pdict.reportingURLs.length}">
            <isinclude template="reporting/reportingUrls" />
        </isif>

        <div class="search__top">
            <!---Breadcrumbs--->
            <nav aria-label="breadcrumb">
                <isinclude template="components/breadcrumbs/pageBreadcrumbs"/>
            </nav>
        </div>
    </div>

    <div class="container">
        <div class="box box__card ${(contentsNotEmpty && !productsNotEmpty) ? 'hidden' : ''}" id="product-search-results">
            <iscomment> GA4 to be triggered when plp shows </iscomment>
            <isif condition="${!empty(pdict.ga4PLPData)}">
                <input type="hidden" value="${pdict.ga4PLPData}" id="plp-ga4-data">
            </isif>
            <div class="row">
                <isif condition="${productsNotEmpty}">
                    <div class="container">
                        <iscontentasset aid="product-search-results-header"/>
                    </div>
                    <div class="col-12 col-lg-3">
                        <div class="product-filters-wrapper">
                            <div class="products-filters-header">
                                <isif condition="${pdict.productSearch.isCategorySearch}">
                                    <isset name="parentCategory" value="${pdict.isBrandCategoryPage ? dw.web.Resource.msg("suggestions.title.brands", "header", null) : pdict.parentCategoryName}" scope="page" />
                                    <isset name="categoryName" value="${pdict.isBrandCategoryPage && !empty(pdict.brandParam) ? pdict.brandParam : pdict.productSearch.category.name}" scope="page" />

                                    <span class="h4 m-0 text-uppercase">${parentCategory}</span>
                                    <h1 class="h3" role="heading" arial-level="1">${categoryName}</h1>
                                <iselseif condition="${pdict.searchPhrase}" />
                                    <h2 class="h4 m-0">${Resource.msg('label.search.text', 'search', null)}</h2>
                                    <h1 class="h3" role="heading" arial-level="1">${pdict.searchPhrase}</h1>
                                </isif>
                                <span class="product-results-count"><b>${Resource.msgf('label.results.count.total', 'search', null,pdict.paging.totalCount)}</b>${Resource.msg('label.results.count.text', 'search', null)}</span>
                            </div>
                            <isif condition="${pdict.productSearch.productIds.length > 0}">
                                <!-- Refinement bar -->
                                <div class="d-none d-lg-block">
                                    <isinclude url="${pdict.refineurl}"/>
                                </div>
                            </isif>
                            <div class="filter-espot-wrapper"></div>
                        </div>
                        <iscomment>
                            TOPSORT side banner. Two things about where this sits:

                            It is a sibling of .product-filters-wrapper, not a child, because
                            that wrapper is overflow:hidden and an ancestor with an overflow
                            other than visible becomes the scroll container for a sticky
                            descendant - the banner would pin inside the filter box.

                            It is also a direct child of the column rather than being wrapped
                            in a responsive div, because a sticky element can only travel
                            inside its own parent. The column stretches to the height of the
                            results next to it, which is the distance the banner follows.
                        </iscomment>
                        <isif condition="${pdict.productSearch.productIds.length > 0}">
                            <isset name="tsSlotId" value="${tsSideSlotId}" scope="page" />
                            <isset name="tsSlotClass" value="${'d-none d-lg-block'}" scope="page" />
                            <isinclude template="topsort/bannerSlot" />
                        </isif>
                    </div>
                    <div class="col-12 col-lg-9 product-grid pt-0" id="product-list">
                        <isslot id="searchresults-secondary-banner" description="Content slot for banner (same width as product results)" context="global" />

                        <div class="grid-filters grid-filters-fixed new-grid-filters new-grid-filters-fixed d-none d-lg-none">
                            <div class="grid-filters-container js-grid-filters-fixed">
                                <div class="filter-col d-flex filter-by filter-modal-container d-lg-none">
                                    <div class="d-flex d-lg-none filter-grid js-filter-btn">
                                        <svg class="icon icon-filter"><use xlink:href="#filter-icon"></use></svg>
                                        <p class="filter-lbl order-lbl text-uppercase no-margins">${Resource.msg('label.control.filter', 'search', null)}</p>
                                    </div>
                                    <isinclude url="${pdict.refineurl}"/>
                                </div>

                                <div class="filter-col d-flex order-by">
                                    <label class="filter-label" for="order-by">${Resource.msg('label.control.sortby', 'search', null)}</label>
                                    <isinclude template="search/sortOrderMenu" />
                                </div>
                            </div>
                        </div>

                        <div class="grid-filters grid-filters-static new-grid-filters">
                            <div class="filter-col d-flex d-lg-none filter-grid js-filter-btn">
                                <svg class="icon icon-filter"><use xlink:href="#filter-icon"></use></svg>
                                <p class="filter-lbl order-lbl text-uppercase no-margins">${Resource.msg('label.control.filter', 'search', null)}</p>
                            </div>


                            <div class="filter-col d-flex order-by">
                                <label class="filter-label d-none d-lg-block" for="order-by">${Resource.msg('label.control.sortby', 'search', null)}</label>
                                <isinclude template="search/sortOrderMenu" />
                            </div>

                            <div class="filter-col d-none d-lg-flex pagination">
                                <isinclude template="search/components/pagination" />
                            </div>
                        </div>

                        <!--- Product Grid --->
                        <div class="row px-3 grid-view product-view loading" id="productRow">
                            <isinclude template="search/productGrid" />
                        </div>

                        <div class="bottom-placeholder">
                            <isinclude template="search/components/pagination" />
                        </div>

                        <isslot id="searchresults-footer-secondary-banner" description="Content slot for banner to display below pagination" context="global" />
                    </div>
                <iselse/>
                    <isobject object="${pdict.productSearch.productSearch}" view="none"> </isobject>
                    <isinclude template="search/components/emptyResults" />
                </isif>
            </div>
        </div>
    </div>

    <isif condition="${contentsNotEmpty}">
        <div class="box box__card ${productsNotEmpty ? 'hidden' : ''}" id="articles-search-results">
            <iscontentasset aid="articles-search-results-header" />

            <div class="container">
                <isinclude template="search/contentGrid" />
                <div class="recommendation-slider-wrapper">
                    <isslot id="recommended-products" description="Carousel of recommended products driven by Einstein Product Recommendation." context="global" />
                </div>
            </div>

            <iscontentasset aid="articles-search-results-footer" />
        </div>
    </isif>

    <iscomment>
        TOPSORT footer banner. Outside the .container and outside the col-lg-9 grid column so
        it runs the full width of the viewport, which is what this placement was specified as.
    </iscomment>
    <isif condition="${productsNotEmpty}">
        <div class="mt-8">
            <isset name="tsSlotId" value="${tsFooterSlotId}" scope="page" />
            <isset name="tsSlotClass" value="${''}" scope="page" />
            <isinclude template="topsort/bannerSlot" />
        </div>
    </isif>

    <div class="mt-8">
        <isslot id="searchresults-footer-banner" description="Content slot for full-width banner to display below product grid/list" context="global" />
    </div>
</section>
