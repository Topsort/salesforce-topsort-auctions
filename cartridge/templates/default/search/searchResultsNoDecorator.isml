<isif condition="${pdict.reportingURLs && pdict.reportingURLs.length}">
    <isinclude template="reporting/reportingUrls" />
</isif>

<script src="${URLUtils.staticURL('/js/product-engagement.js')}"></script>
<script>
  if (window.ProductEngagement) {
    ProductEngagement.init({
      apiURL: '${pdict.topsortApiURL}',
      apiKey: '${pdict.topsortApiKey}',
      trackingEnabled: ${pdict.topsortTrackingEnabled ? true : false}
    });
  }
</script>

<isset name="searchTopBanner" value="${pdict.bannerWinners['search-top']}" scope="page" />
<isif condition="${searchTopBanner && searchTopBanner.url}">
    <div id="featured-content-search-top" class="featured-content-container" style="margin-top: 1rem;">
        <a href="${searchTopBanner.redirectionUrl}" target="_blank" rel="noopener">
            <img src="${searchTopBanner.url}" alt="Featured Content" style="width: 100%; border-radius: 12px;" />
        </a>
    </div>
    <isif condition="${searchTopBanner.bidId}">
        <script>
            if (window.ProductEngagement) {
                ProductEngagement.setupContentTracking({
                    elementId: 'featured-content-search-top',
                    userId: '${pdict.tsuid || ""}',
                    position: 4,
                    page: ${pdict.productSearch.page || 1},
                    pageSize: ${pdict.productSearch.hitsPerPage || 12},
                    categoryId: '${pdict.request.querystring.cgid || ""}',
                    resolvedBidId: '${searchTopBanner.bidId || ""}'
                });
            }
        </script>
    </isif>
</isif>

<isset name="categoryTopBanner" value="${pdict.bannerWinners['category-top']}" scope="page" />
<isif condition="${categoryTopBanner && categoryTopBanner.url}">
    <div id="featured-content-category-top" class="featured-content-container" style="margin-top: 1rem;">
        <a href="${categoryTopBanner.redirectionUrl}" target="_blank" rel="noopener">
            <img src="${categoryTopBanner.url}" alt="Featured Content" style="width: 100%; border-radius: 12px;" />
        </a>
    </div>
    <isif condition="${categoryTopBanner.bidId}">
        <script>
            if (window.ProductEngagement) {
                ProductEngagement.setupContentTracking({
                    elementId: 'featured-content-category-top',
                    userId: '${pdict.tsuid || ""}',
                    position: 4,
                    page: ${pdict.productSearch.page || 1},
                    pageSize: ${pdict.productSearch.hitsPerPage || 12},
                    categoryId: '${pdict.request.querystring.cgid || ""}',
                    resolvedBidId: '${categoryTopBanner.bidId || ""}'
                });
            }
        </script>
    </isif>
</isif>

<!--- Search Results Banner --->
<isif condition="${pdict.productSearch.isCategorySearch}">
    <div class="hero slant-down search-banner"
        <!--- If no image, default is specified in search.scss > .search-banner --->
        <isif condition="${pdict.productSearch.bannerImageUrl}">
            style="background-image: url(${pdict.productSearch.bannerImageUrl})"
        </isif>
    >
        <h1 class="header page-title">
            ${pdict.productSearch.category.name}
        </h1>
    </div>
<iselse>
    <isslot id="search-result-banner-m" description="Banner for search results" context="global" />
</isif>

<div class="container search-results">
    <div class="row search-nav">
        <isif condition="${!pdict.productSearch.isCategorySearch}">
            <div class="nav-tabs-wrapper">
                <ul class="nav nav-tabs nav-fill" role="tablist">

                    <li class="nav-item" role="presentation">
                        <a class="nav-link active product-search" href="#product-search-results" aria-controls="product-search-results" data-toggle="tab" role="tab" aria-selected="true" id="product-tab">
                            ${Resource.msg('tab.nav.search.productsresults', 'search', null)}
                        </a>
                    </li>
                    <li class="nav-item" role="presentation">
                        <a class="nav-link content-search" href="#content-search-results-pane" aria-controls="content-search-results-pane" data-toggle="tab" role="tab" aria-selected="false" id="articles-tab"
                            data-url="${URLUtils.url('Search-Content', 'q', pdict.productSearch.searchKeywords, 'startingPage', 0)}">
                            ${Resource.msg('tab.nav.search.artclesresults', 'search', null)}
                        </a>
                    </li>
                </ul>
            </div>
        </isif>
    </div>
    <div class="row">
        <div class="tab-content col-12">
            <div class="tab-pane container active" id="product-search-results" role="tabpanel" aria-labelledby="product-tab">

                    <isif condition="${pdict.productSearch.productIds.length > 0}">
                        <div class="row grid-header">
                            <div class="result-count text-center col-12 col-md-9 col-sm-6 order-sm-2">
                    <iselse>
                        <div class="row grid-header justify-content-center">
                            <div class="result-count col">
                    </isif>
                        <isinclude template="search/resultsCount" />
                    </div>
                    <isif condition="${pdict.productSearch.productIds.length > 0}">
                        <div class="col-6 col-sm-3 order-sm-1">
                            <isinclude template="search/sortOrderMenu" />
                        </div>

                        <div class="col-6 col-sm-3 text-right d-md-none order-sm-3">
                            <button type="button" class="btn btn-primary filter-results col-12">
                                ${Resource.msg('button.filter', 'search', null)}
                            </button>
                        </div>
                    </isif>
                </div>

                <isif condition="${pdict.productSearch.productIds.length > 0}">
                    <!--- Refinement bar --->
                    <div class="row">
                        <div class="refinement-bar col-md-3">
                            <isinclude url="${pdict.refineurl}"/>

                            <isset name="categorySideBanner" value="${pdict.bannerWinners['category-side']}" scope="page" />
                            <isif condition="${categorySideBanner && categorySideBanner.url}">
                                <div id="featured-content-category-side" class="refinement-bar__banner" style="padding: 1rem 0;">
                                    <a href="${categorySideBanner.redirectionUrl}" target="_blank" rel="noopener">
                                        <img src="${categorySideBanner.url}" alt="Category Banner" style="width: 100%; border-radius: 12px;" />
                                    </a>
                                </div>
                                <isif condition="${categorySideBanner.bidId}">
                                    <script>
                                    if (window.ProductEngagement) {
                                      ProductEngagement.setupContentTracking({
                                        elementId: 'featured-content-category-side',
                                        userId: '${pdict.tsuid || ""}',
                                        position: 2,
                                        page: ${pdict.productSearch.page || 1},
                                        pageSize: ${pdict.productSearch.hitsPerPage || 12},
                                        categoryId: '${pdict.request.querystring.cgid || ""}',
                                        resolvedBidId: '${categorySideBanner.bidId || ""}'
                                      });
                                    }
                                    </script>
                                </isif>
                            </isif>

                            <isset name="searchSideBanner" value="${pdict.bannerWinners['search-side']}" scope="page" />
                            <isif condition="${searchSideBanner && searchSideBanner.url}">
                                <div id="featured-content-search-side" class="refinement-bar__banner" style="padding: 1rem 0;">
                                    <a href="${searchSideBanner.redirectionUrl}" target="_blank" rel="noopener">
                                        <img src="${searchSideBanner.url}" alt="Search Side Banner" style="width: 100%; border-radius: 12px;" />
                                    </a>
                                </div>
                                <isif condition="${searchSideBanner.bidId}">
                                    <script>
                                        if (window.ProductEngagement) {
                                            ProductEngagement.setupContentTracking({
                                                elementId: 'featured-content-search-side',
                                                userId: '${pdict.tsuid || ""}',
                                                position: 3,
                                                page: ${pdict.productSearch.page || 1},
                                                pageSize: ${pdict.productSearch.hitsPerPage || 12},
                                                categoryId: '${pdict.request.querystring.cgid || ""}',
                                                resolvedBidId: '${searchSideBanner.bidId || ""}'
                                            });
                                        }
                                    </script>
                                </isif>
                            </isif>
                        </div>

                        <div class="col-sm-12 col-md-9">
                             <!--- Selected filters bar --->
                             <div class="row filter-bar d-md-none">
                                 <isinclude template="search/filterBar" />
                             </div>

                             <!--- Product Grid --->
                             <div class="row product-grid" itemtype="http://schema.org/SomeProducts" itemid="#product">
                                 <isinclude template="search/productGrid" />
                             </div>

                             <isset name="categoryBottomBanner" value="${pdict.bannerWinners['category-bottom']}" scope="page" />
                             <isif condition="${categoryBottomBanner && categoryBottomBanner.url}">
                                 <div id="featured-content-category-bottom" class="featured-content-container" style="margin-top: 1rem;">
                                     <a href="${categoryBottomBanner.redirectionUrl}" target="_blank" rel="noopener">
                                         <img src="${categoryBottomBanner.url}" alt="Featured Content" style="width: 100%; border-radius: 12px;" />
                                     </a>
                                 </div>
                                 <isif condition="${categoryBottomBanner.bidId}">
                                     <script>
                                     if (window.ProductEngagement) {
                                       ProductEngagement.setupContentTracking({
                                         elementId: 'featured-content-category-bottom',
                                         userId: '${pdict.tsuid || ""}',
                                         position: 1,
                                         page: ${pdict.productSearch.page || 1},
                                         pageSize: ${pdict.productSearch.hitsPerPage || 12},
                                         categoryId: '${pdict.request.querystring.cgid || ""}',
                                         resolvedBidId: '${categoryBottomBanner.bidId || ""}'
                                       });
                                     }
                                     </script>
                                 </isif>
                             </isif>

                             <isset name="searchBottomBanner" value="${pdict.bannerWinners['search-bottom']}" scope="page" />
                             <isif condition="${searchBottomBanner && searchBottomBanner.url}">
                                 <div id="featured-content-search-bottom" class="featured-content-container" style="margin-top: 1rem; margin-bottom: 3rem;">
                                     <a href="${searchBottomBanner.redirectionUrl}" target="_blank" rel="noopener">
                                         <img src="${searchBottomBanner.url}" alt="Featured Content" style="width: 100%; border-radius: 12px;" />
                                     </a>
                                 </div>
                                 <isif condition="${searchBottomBanner.bidId}">
                                     <script>
                                         if (window.ProductEngagement) {
                                             ProductEngagement.setupContentTracking({
                                                 elementId: 'featured-content-search-bottom',
                                                 userId: '${pdict.tsuid || ""}',
                                                 position: 4,
                                                 page: ${pdict.productSearch.page || 1},
                                                 pageSize: ${pdict.productSearch.hitsPerPage || 12},
                                                 categoryId: '${pdict.request.querystring.cgid || ""}',
                                                 resolvedBidId: '${searchBottomBanner.bidId || ""}'
                                             });
                                         }
                                     </script>
                                 </isif>
                             </isif>
                        </div>
                    </div>
                </isif>
            </div>
            <!--- Content Grid --->
            <div class="tab-pane container" id="content-search-results-pane" role="tabpanel" aria-labelledby="articles-tab">
                <div id="content-search-results" class="content-grid-header"></div>
            </div>

        </div>
    </div>
</div>
